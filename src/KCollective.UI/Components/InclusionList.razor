<ul class="kc-inclusions">
    @foreach (var item in Items)
    {
        <li>
            <span class="kc-inclusion-thumb kind-@item.Kind" aria-hidden="true">@((MarkupString)Icon(item.Kind))</span>
            <span class="kc-inclusion-label">@item.Label</span>
            <span class="kc-inclusion-detail">@item.Detail</span>
        </li>
    }
</ul>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<Inclusion> Items { get; set; } = [];

    // Simple line-art thumbnails; real inclusion photos come with catalog publishing.
    private static string Icon(string kind) => kind switch
    {
        "book" => """<svg viewBox="0 0 32 32"><rect x="7" y="5" width="18" height="22" rx="2"/><line x1="11" y1="5" x2="11" y2="27"/></svg>""",
        "cd" => """<svg viewBox="0 0 32 32"><circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="3"/></svg>""",
        "card" => """<svg viewBox="0 0 32 32"><rect x="10" y="4" width="13" height="22" rx="2"/><rect x="7" y="7" width="13" height="22" rx="2" class="back"/></svg>""",
        "postcard" => """<svg viewBox="0 0 32 32"><rect x="4" y="8" width="24" height="16" rx="2"/><line x1="17" y1="11" x2="17" y2="21"/><rect x="21" y="11" width="4" height="4"/></svg>""",
        "sticker" => """<svg viewBox="0 0 32 32"><path d="M6 6h20v13l-7 7H6z"/><path d="M19 26v-7h7"/></svg>""",
        _ => """<svg viewBox="0 0 32 32"><rect x="6" y="6" width="20" height="20" rx="3"/></svg>""",
    };
}
